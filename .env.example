# Copy to .env and fill in real values. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-your-key-here
PROMETHEUS_URL=http://localhost:9090
CONTROLPLANE_DATABASE_URL=postgresql://sentinelops:sentinelops@localhost:5433/sentinelops
# Optional: full path to the docker CLI if it is not on PATH (e.g. ~/.orbstack/bin/docker)
DOCKER_BIN=docker
# Optional: OpenAI model used only if Claude is unavailable (needs OPENAI_API_KEY too)
OPENAI_MODEL=
# Automatic investigation of incidents opened from alerts (read-only, but each run costs money)
AUTO_INVESTIGATE=true
INVESTIGATION_CONCURRENCY=2
AUTO_INVESTIGATE_DAILY_BUDGET_USD=2.0
AUTO_INVESTIGATE_REPEAT_HOURS=24
INCIDENT_GROUP_WINDOW_MINUTES=5
